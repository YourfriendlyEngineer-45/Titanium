# ============================================================
# TITANIUM .gitignore
# Element 22 OPC - Frozen Empire Standard
# ============================================================

# === BUILD ARTIFACTS (The Reactor Exhaust) ===
# These are generated by Maven. Never commit them.
target/
*.jar
*.class
dependency-reduced-pom.xml
build/

# === IDE NOISE (The Enterprise Bloat) ===
# Keep your editor's preferences out of the source of truth.
.idea/
*.iml
.vscode/
.settings/
.project
.classpath
.factorypath
*.swp
*.swo
*~

# === ENVIRONMENT SECRETS (The Plutonium) ===
# NEVER commit database passwords or API keys.
# Use a local .env file that is ignored here.
.env
.env.local
.env.*
*.pem
*.key

# === OS JUNK (The Rust) ===
# Trash files generated by Windows and macOS.
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# === LOGS (The Radioactive Waste) ===
# Runtime logs should stay on the server, not in Git.
*.log
logs/
nohup.out
hs_err_pid*

# === MAVEN WRAPPER (Optional) ===
# If you use the Maven Wrapper scripts, you can ignore them 
# if you prefer relying on the system's `mvn` command.
.mvn/
mvnw
mvnw.cmd

# === DEPLOYMENT CONFIGS (The Landlord Keys) ===
# Any local scripts or configs used specifically for your 
# personal OCI deployment should stay private.
landlord-config/
deploy-keys/
